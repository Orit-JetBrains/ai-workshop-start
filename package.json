{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:demo",
    "test:unit": "node --test tests/*.test.ts",
    "test:demo": "playwright test",
    "test:demo:record": "node scripts/record-demo.mjs",
    "test:real": "node scripts/real-repos.mjs",
    "test:real:update": "node scripts/real-repos.mjs --update",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/demo"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
